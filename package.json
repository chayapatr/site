{
	"name": "v11",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build:manifest": "node scripts/build-manifest.js",
		"predev": "node scripts/build-manifest.js",
		"prebuild": "node scripts/build-manifest.js",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
