		"micromark-extension-gfm-table": "^2.1.1",
		"rehype": "^13.0.2",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"unist-util-visit": "^5.1.0"
	}
