/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

@font-face {
	font-family: 'Basier Circle';
	src: url('/fonts/basier-regular.woff2') format('woff2');
	font-weight: 400;
	font-style: regular;
}

@font-face {
	font-family: 'Basier Circle';
	src: url('/fonts/basier-medium.woff2') format('woff2');
	font-weight: 500;
	font-style: regular;
}

@font-face {
	font-family: 'Zed Mono Extended';
	src: url('/fonts/zed-mono-extended.ttf') format('truetype');
	font-weight: 500;
	font-style: regular;
}

@font-face {
	font-family: 'Anuphan';
	src: url('/fonts/Anuphan-Regular.ttf') format('truetype');
	font-weight: 500;
	font-style: regular;
}

body {
	font-family: 'Basier Circle', 'Anuphan', sans-serif;
}

.glass {
	/* background: linear-gradient(135deg, rgba(100, 100, 100, 0.07), rgba(100, 100, 100, 0.15)); */
	background: rgba(255, 255, 255, 0.6);
	backdrop-filter: blur(2px);
	-webkit-backdrop-filter: blur(2px);
}

.glass-dark {
	/* background: linear-gradient(135deg, rgba(100, 100, 100, 0.07), rgba(100, 100, 100, 0.15)); */
	background: rgba(30, 30, 30, 0.3);
	backdrop-filter: blur(2px);
	-webkit-backdrop-filter: blur(2px);
}
